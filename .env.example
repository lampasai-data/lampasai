# Copy this file to .env and fill in the values. .env is gitignored; this
# template is committed so the required configuration is documented somewhere.

# Supabase project URL and public anon key. Both are baked into the built JS
# bundle and are safe to expose - row level security is what protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Service role key. SECRET: it bypasses every row level security policy and
# grants full read/write on the database. Never prefix it with VITE_ (that
# would ship it to the browser) and never commit its value. Only needed to run
# maintenance scripts locally, e.g. scripts/import-quiz-questions.mjs.
SUPABASE_SERVICE_ROLE_KEY=
